# Backend HTTP port exposed by the Mitbauen binary itself.
app_service_http_port=8080

# Database connection used by the Mitbauen binary.
jdbc_database_url=jdbc:postgresql://127.0.0.1:5432/mitbauen
jdbc_database_user=mitbauen
jdbc_database_password=change_me

# Email verification via Resend.
app_public_base_url=https://www.mitbauen.space
app_email_from=Mitbauen <no-reply@mail.mitbauen.space>
resend_api_key=

# Optional project description fallback translations.
# If either value is unset, responses only include creator-authored description text.
app_translation_openai_api_key=
app_translation_openai_model=gpt-5-mini
